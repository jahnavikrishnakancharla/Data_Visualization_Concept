# Import matplotlib's pyplot module for creating visualizations
import matplotlib.pyplot as plt

# Create a figure with width = 10 inches and height = 5 inches
plt.figure(figsize=(10, 5))

# Create Box Plots for Order Value and Cost
# patch_artist=True allows the boxes to be filled/styled
# showmeans=True displays the mean as a separate marker
